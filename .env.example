NODE_ENV='development'
FRONTEND_URL='http://localhost:3001/'

JWT_SECRET='secret'

# database
DB_HOST='localhost'
DB_PORT='5432'
DB_USERNAME=''
DB_PASSWORD='postgres'
DB_DATABASE='nest_db'

# mail (local dev: Mailpit from docker-compose, inbox at http://localhost:8025)
SMTP_HOST='localhost'
SMTP_PORT='1025'
SMTP_SECURE=
SMTP_USER=''
SMTP_PASSWORD=''
SMTP_FROM='no-reply@example.com'

# storage (local dev: RustFS from docker-compose, console at http://localhost:9001)
S3_ENDPOINT='http://localhost:9000'
S3_REGION='us-east-1'
S3_ACCESS_KEY_ID='rustfs-dev'
S3_SECRET_ACCESS_KEY='rustfs-dev-secret'
S3_BUCKET='nest-boilerplate'
S3_FORCE_PATH_STYLE='true'

#redis
REDIS_HOST=''
REDIS_PORT=''
REDIS_PASSWORD=
